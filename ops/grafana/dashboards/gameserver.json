{
  "uid": "gameserver-v2",
  "title": "GameServer-v2: sessions, matchmaking, clan wars",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "gameserver"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Dead letters (all services)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(wolverine_dead_letters)"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Failed season grants",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(clanwars_reward_grants{status=\"Failed\"})"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Failed match grants",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(matchmaking_reward_grants{status=\"Failed\"})"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Game servers online",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(session_game_servers_online)"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Queues",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (matchmaking_queue_length)",
          "legendFormat": "matchmaking {{mode}}"
        },
        {
          "refId": "B",
          "expr": "clanwars_battle_queue_length",
          "legendFormat": "clan battle squads"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Matches and battles",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "matchmaking_matches_active",
          "legendFormat": "active matches"
        },
        {
          "refId": "B",
          "expr": "matchmaking_matches_waiting_for_server",
          "legendFormat": "waiting for server"
        },
        {
          "refId": "C",
          "expr": "clanwars_battles_open",
          "legendFormat": "open battles"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "session_sessions_open",
          "legendFormat": "open {{kind}}"
        },
        {
          "refId": "B",
          "expr": "session_players_online",
          "legendFormat": "players online"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Match reports per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(session_match_reports_total[5m])) * 60",
          "legendFormat": "{{result}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Reward grants",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clanwars_reward_grants",
          "legendFormat": "season {{status}}"
        },
        {
          "refId": "B",
          "expr": "matchmaking_reward_grants",
          "legendFormat": "match {{status}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Roster projection lag p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(clanwars_roster_event_lag_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Leaderboard Redis vs PostgreSQL",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(clanwars_leaderboard_divergences_total[30m])",
          "legendFormat": "clan divergences"
        },
        {
          "refId": "B",
          "expr": "increase(clanwars_leaderboard_rebuilds_total[30m])",
          "legendFormat": "clan rebuilds"
        },
        {
          "refId": "C",
          "expr": "increase(matchmaking_leaderboard_divergences_total[30m])",
          "legendFormat": "player divergences"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Battles and abuse signals per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(clanwars_battles_finished_total[1h]))",
          "legendFormat": "battles {{status}}"
        },
        {
          "refId": "B",
          "expr": "sum by (kind) (increase(clanwars_abuse_signals_total[1h]))",
          "legendFormat": "abuse {{kind}}"
        }
      ],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Matches cancelled before start",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(matchmaking_matches_cancelled_before_start_total[1h]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "id": 14
    }
  ]
}
