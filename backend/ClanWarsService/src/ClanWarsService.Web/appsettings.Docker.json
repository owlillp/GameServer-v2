{
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:6100",
      "http://localhost:3000"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": [
      "*"
    ],
    "AllowedMethods": [
      "*"
    ]
  },
  "ConnectionStrings": {
    "ClanWarsDb": "Server=postgres;Port=5432;Database=clanwars_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@rabbitmq:5672/",
    "Redis": "redis:6379"
  },
  "Authentication": {
    "Authority": "http://auth-service:8080/",
    "Audiences": [
      "clanwars-service"
    ]
  },
  "ServiceAuth": {
    "Authority": "http://auth-service:8080/",
    "ClientId": "clanwars-service-client",
    "ClientSecret": "dev-only-secret-change-me-0123456789",
    "Scopes": [
      "wallet"
    ]
  },
  "WalletService": {
    "GrpcAddress": "http://wallet-service:8081",
    "DeadlineSeconds": 3,
    "MaxAttempts": 2
  }
}
