{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": [
      "*"
    ],
    "AllowedMethods": [
      "*"
    ]
  },
  "ConnectionStrings": {
    "ClanWarsDb": "Server=localhost;Port=5436;Database=clanwars_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@localhost:5672/",
    "Redis": "localhost:6379"
  },
  "Authentication": {
    "Authority": "http://localhost:5280/",
    "Audiences": [
      "clanwars-service"
    ]
  },
  "ServiceAuth": {
    "Authority": "http://localhost:5280/",
    "ClientId": "clanwars-service-client",
    "ClientSecret": "dev-only-secret-change-me-0123456789",
    "Scopes": [
      "wallet"
    ]
  },
  "WalletService": {
    "GrpcAddress": "http://localhost:5284",
    "DeadlineSeconds": 3,
    "MaxAttempts": 2
  }
}
