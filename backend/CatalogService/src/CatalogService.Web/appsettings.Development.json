{
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "CatalogDb": "Server=localhost;Port=5436;Database=catalog_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@localhost:5672/",
    "Redis": "localhost:6379"
  },
  "Authentication": {
    "Authority": "http://localhost:5280/",
    "Audiences": ["catalog-service"]
  },
  "CacheOptions": {
    "LocalCacheExpirationMinutes": 5,
    "CacheExpirationMinutes": 60,
    "EnableRedisCache": true
  }
}
