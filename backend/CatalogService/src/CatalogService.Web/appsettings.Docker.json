{
  "Cors": {
    "AllowedOrigins": ["https://localhost:6100", "http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "CatalogDb": "Server=postgres;Port=5432;Database=catalog_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@rabbitmq:5672/",
    "Redis": "redis:6379"
  },
  "Authentication": {
    "Authority": "http://auth-service:8080/",
    "Audiences": ["catalog-service"]
  },
  "CacheOptions": {
    "LocalCacheExpirationMinutes": 5,
    "CacheExpirationMinutes": 60,
    "EnableRedisCache": true
  }
}
