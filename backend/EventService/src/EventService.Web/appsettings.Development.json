{
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "EventDb": "Server=localhost;Port=5436;Database=event_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@localhost:5672/"
  },
  "Authentication": {
    "Authority": "http://localhost:5280/",
    "Audiences": ["event-service"]
  },
  "Events": {
    "PhaseSweepIntervalSeconds": 10
  }
}
