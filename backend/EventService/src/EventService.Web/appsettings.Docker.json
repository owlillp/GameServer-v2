{
  "Cors": {
    "AllowedOrigins": ["https://localhost:6100", "http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "EventDb": "Server=postgres;Port=5432;Database=event_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@rabbitmq:5672/"
  },
  "Authentication": {
    "Authority": "http://auth-service:8080/",
    "Audiences": ["event-service"]
  },
  "Events": {
    "PhaseSweepIntervalSeconds": 30
  }
}
