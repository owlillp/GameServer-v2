{
  "Cors": {
    "AllowedOrigins": ["https://localhost:6000", "https://localhost:6002", "http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "AuthDb": "Server=postgres;Port=5432;Database=auth_service_db;User Id=postgres;Password=postgres;"
  },
  "OpenIddict": {
    "Issuer": "https://localhost:6002/",
    "Clients": {
      "Web": {
        "ClientId": "gameserver-v2-web",
        "DisplayName": "GameServer-v2 Web",
        "RedirectUris": ["https://localhost:6000/auth/callback", "http://localhost:3000/auth/callback"],
        "PostLogoutRedirectUris": ["https://localhost:6000"]
      },
      "Unity": {
        "ClientId": "gameserver-v2-unity",
        "DisplayName": "GameServer-v2 Unity Client",
        "RedirectUris": ["http://127.0.0.1:7777/callback", "gameserver-v2://auth/callback"]
      },
      "ClanService": {
        "ClientId": "clan-service-client",
        "ClientSecret": "dev-only-secret-change-me-0123456789",
        "DisplayName": "ClanService service client"
      }
    }
  },
  "Authentication": {
    "Authority": "http://auth-service:8080/",
    "Audiences": ["auth-service"]
  },
  "AuthService": {
    "FrontendLoginUrl": "https://localhost:6000/login"
  }
}
