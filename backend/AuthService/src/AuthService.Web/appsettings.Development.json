{
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "AuthDb": "Server=localhost;Port=5436;Database=auth_service_db;User Id=postgres;Password=postgres;"
  },
  "OpenIddict": {
    "Issuer": "http://localhost:5280/",
    "Clients": {
      "Web": {
        "ClientId": "gameserver-v2-web",
        "DisplayName": "GameServer-v2 Web (dev)",
        "RedirectUris": ["http://localhost:3000/auth/callback"],
        "PostLogoutRedirectUris": ["http://localhost:3000"]
      },
      "Unity": {
        "ClientId": "gameserver-v2-unity",
        "DisplayName": "GameServer-v2 Unity Client (dev)",
        "RedirectUris": ["http://127.0.0.1:7777/callback", "gameserver-v2://auth/callback"]
      },
      "ClanService": {
        "ClientId": "clan-service-client",
        "ClientSecret": "dev-only-secret-change-me-0123456789",
        "DisplayName": "ClanService service client (dev)"
      }
    }
  },
  "Authentication": {
    "Authority": "http://localhost:5280/",
    "Audiences": ["auth-service"]
  },
  "AuthService": {
    "FrontendLoginUrl": "http://localhost:3000/login"
  }
}
