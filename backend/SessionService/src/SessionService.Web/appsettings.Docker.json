{
  "Cors": {
    "AllowedOrigins": ["https://localhost:6100", "http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "SessionDb": "Server=postgres;Port=5432;Database=session_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@rabbitmq:5672/",
    "Redis": "redis:6379"
  },
  "Authentication": {
    "Authority": "http://auth-service:8080/",
    "Audiences": ["session-service"]
  },
  "JoinTickets": {
    "AllowEphemeralKey": true
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  }
}
