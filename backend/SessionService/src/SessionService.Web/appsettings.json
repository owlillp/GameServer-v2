{
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SessionDb": "",
    "RabbitMQ": "",
    "Redis": ""
  },
  "Authentication": {
    "Authority": "",
    "Audiences": ["session-service"]
  },
  "GameServerAuth": {
    "AllowedClientIds": ["game-server"],
    "RequiredScope": "session.write"
  },
  "ServiceClientAuth": {
    "AllowedClientIds": ["matchmaking-service-client"],
    "RequiredScope": "session"
  },
  "JoinTickets": {
    "Issuer": "session-service",
    "Audience": "game-server",
    "LifetimeSeconds": 60,
    "SigningKeyPem": "",
    "KeyId": "session-ticket-1",
    "AllowEphemeralKey": false
  },
  "Sessions": {
    "HeartbeatIntervalSeconds": 5,
    "ServerTtlSeconds": 20,
    "SessionTtlSeconds": 30,
    "NewSessionTtlSeconds": 120,
    "FreeRoamMaxPlayers": 32,
    "DefaultFreeRoamMode": "FREE-ROAM",
    "JoinCandidates": 20,
    "LivenessSweepIntervalSeconds": 10,
    "LivenessBatchSize": 100,
    "HeartbeatPersistSeconds": 30
  },
  "AntiCheat": {
    "MinMatchSeconds": 30,
    "MaxMatchMinutes": 180,
    "MaxScorePerMinute": 1000,
    "MaxKillsPerMinute": 30
  }
}
