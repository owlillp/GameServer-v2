{
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "SessionDb": "Server=localhost;Port=5436;Database=session_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@localhost:5672/",
    "Redis": "localhost:6379"
  },
  "Authentication": {
    "Authority": "http://localhost:5280/",
    "Audiences": ["session-service"]
  },
  "JoinTickets": {
    "AllowEphemeralKey": true
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5289",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://localhost:5290",
        "Protocols": "Http2"
      }
    }
  }
}
