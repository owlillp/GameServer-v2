{
  "Cors": {
    "AllowedOrigins": ["https://localhost:6100", "http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "MatchmakingDb": "Server=postgres;Port=5432;Database=matchmaking_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@rabbitmq:5672/",
    "Redis": "redis:6379"
  },
  "Authentication": {
    "Authority": "http://auth-service:8080/",
    "Audiences": ["matchmaking-service"]
  },
  "ServiceAuth": {
    "Authority": "http://auth-service:8080/",
    "ClientId": "matchmaking-service-client",
    "ClientSecret": "dev-only-secret-change-me-0123456789",
    "Scopes": ["wallet"]
  },
  "WalletService": {
    "Url": "http://wallet-service:8080",
    "TimeoutSeconds": 5
  },
  "Matchmaking": {
    "PairingIntervalSeconds": 10,
    "RewardRetryIntervalSeconds": 30,
    "DefaultMatchDurationHours": 48,
    "DefaultMode": "RANKED",
    "DefaultCurrencyCode": "coins",
    "DefaultParticipationReward": 100,
    "DefaultWinBonus": 150,
    "RequireSamePartySize": true,
    "AutoFinishMatches": true,
    "LeaderboardSize": 1000,
    "LeaderboardRefreshMinutes": 5
  }
}
