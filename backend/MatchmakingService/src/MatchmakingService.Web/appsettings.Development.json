{
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "MatchmakingDb": "Server=localhost;Port=5436;Database=matchmaking_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@localhost:5672/",
    "Redis": "localhost:6379"
  },
  "Authentication": {
    "Authority": "http://localhost:5280/",
    "Audiences": ["matchmaking-service"]
  },
  "ServiceAuth": {
    "Authority": "http://localhost:5280/",
    "ClientId": "matchmaking-service-client",
    "ClientSecret": "dev-only-secret-change-me-0123456789",
    "Scopes": ["wallet", "session"]
  },
  "WalletService": {
    "GrpcAddress": "http://localhost:5284",
    "DeadlineSeconds": 3,
    "MaxAttempts": 2
  },
  "SessionService": {
    "GrpcAddress": "http://localhost:5290",
    "DeadlineSeconds": 3,
    "MaxAttempts": 2
  },
  "Matchmaking": {
    "PairingIntervalSeconds": 10,
    "PairingBatchSize": 100,
    "RewardRetryBatchSize": 50,
    "DefaultMatchDurationHours": 48,
    "DefaultMode": "RANKED",
    "DefaultCurrencyCode": "coins",
    "DefaultParticipationReward": 100,
    "DefaultWinBonus": 150,
    "RequireSamePartySize": true,
    "ResultsSource": "Admin",
    "DefaultRegion": "eu-west",
    "AllocationTimeoutSeconds": 60,
    "MaxAllocationAttempts": 3,
    "AutoFinishMatches": true,
    "ExpiredMatchBatchSize": 20,
    "LeaderboardCheckMinutes": 5,
    "LeaderboardCheckSampleSize": 100,
    "LeaderboardRebuildBatchSize": 1000
  }
}
