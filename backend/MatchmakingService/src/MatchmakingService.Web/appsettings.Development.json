{
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "MatchmakingDb": "Server=localhost;Port=5436;Database=matchmaking_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@localhost:5672/",
    "Redis": "localhost:6379"
  },
  "Authentication": {
    "Authority": "http://localhost:5280/",
    "Audiences": ["matchmaking-service"]
  },
  "ServiceAuth": {
    "Authority": "http://localhost:5280/",
    "ClientId": "matchmaking-service-client",
    "ClientSecret": "dev-only-secret-change-me-0123456789",
    "Scopes": ["wallet"]
  },
  "WalletService": {
    "Url": "http://localhost:5282",
    "TimeoutSeconds": 5
  },
  "Matchmaking": {
    "PairingIntervalSeconds": 10,
    "RewardRetryIntervalSeconds": 30,
    "DefaultMatchDurationHours": 48,
    "DefaultMode": "RANKED",
    "DefaultCurrencyCode": "coins",
    "DefaultParticipationReward": 100,
    "DefaultWinBonus": 150,
    "RequireSamePartySize": true,
    "AutoFinishMatches": true,
    "LeaderboardSize": 1000,
    "LeaderboardRefreshMinutes": 5
  }
}
