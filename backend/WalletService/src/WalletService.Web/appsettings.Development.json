{
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "WalletDb": "Server=localhost;Port=5436;Database=wallet_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@localhost:5672/"
  },
  "Authentication": {
    "Authority": "http://localhost:5280/",
    "Audiences": ["wallet-service"]
  },
  "Grpc": {
    "AllowedClientId": "store-service-client",
    "AllowedClientIds": ["store-service-client", "matchmaking-service-client", "clan-service-client", "clanwars-service-client"]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5282",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://localhost:5284",
        "Protocols": "Http2"
      }
    }
  }
}
