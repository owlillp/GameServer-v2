{
  "Cors": {
    "AllowedOrigins": ["https://localhost:6100", "http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "WalletDb": "Server=postgres;Port=5432;Database=wallet_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@rabbitmq:5672/"
  },
  "Authentication": {
    "Authority": "http://auth-service:8080/",
    "Audiences": ["wallet-service"]
  },
  "Grpc": {
    "AllowedClientId": "store-service-client",
    "AllowedClientIds": ["store-service-client", "matchmaking-service-client", "clan-service-client", "clanwars-service-client"]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  }
}
