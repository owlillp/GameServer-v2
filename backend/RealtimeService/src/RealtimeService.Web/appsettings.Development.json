{
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "RabbitMQ": "amqp://guest:guest@localhost:5672/",
    "Redis": "localhost:6379"
  },
  "Authentication": {
    "Authority": "http://localhost:5280/",
    "Audiences": ["realtime-service"]
  },
  "Realtime": {
    "TicketTtlSeconds": 60
  }
}
