{
  "Cors": {
    "AllowedOrigins": ["https://localhost:6100", "http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "StoreDb": "Server=postgres;Port=5432;Database=store_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@rabbitmq:5672/"
  },
  "Authentication": {
    "Authority": "http://auth-service:8080/",
    "Audiences": ["store-service"]
  },
  "ServiceAuth": {
    "Authority": "http://auth-service:8080/",
    "ClientId": "store-service-client",
    "ClientSecret": "dev-only-secret-change-me-0123456789",
    "Scopes": ["wallet", "catalog", "inventory"]
  },
  "CatalogService": {
    "Url": "http://catalog-service:8080",
    "TimeoutSeconds": 5
  },
  "WalletService": {
    "GrpcAddress": "http://wallet-service:8081",
    "DeadlineSeconds": 3,
    "MaxAttempts": 2
  },
  "Store": {
    "OrderTimeoutMinutes": 15
  }
}
