{
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "StoreDb": "Server=localhost;Port=5436;Database=store_service_db;User Id=postgres;Password=postgres;",
    "RabbitMQ": "amqp://guest:guest@localhost:5672/"
  },
  "Authentication": {
    "Authority": "http://localhost:5280/",
    "Audiences": ["store-service"]
  },
  "ServiceAuth": {
    "Authority": "http://localhost:5280/",
    "ClientId": "store-service-client",
    "ClientSecret": "dev-only-secret-change-me-0123456789",
    "Scopes": ["wallet", "catalog", "inventory"]
  },
  "CatalogService": {
    "Url": "http://localhost:5281",
    "TimeoutSeconds": 5
  },
  "WalletService": {
    "GrpcAddress": "http://localhost:5284",
    "DeadlineSeconds": 3,
    "MaxAttempts": 2
  },
  "Store": {
    "OrderTimeoutMinutes": 15
  }
}
