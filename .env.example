# ===== GitHub Packages (private NuGet feed: Owlip.*) =====
# PAT needs the "read:packages" scope.
NUGET_USERNAME=your-github-username
NUGET_PASSWORD=ghp_your_personal_access_token

# ===== ASP.NET Core =====
ASPNETCORE_ENVIRONMENT=Docker
ASPNETCORE_URLS=http://+:8080

# ===== Databases (host = compose service name) =====
ConnectionStrings__AuthDb=Server=postgres;Port=5432;Database=auth_service_db;User Id=postgres;Password=postgres;
ConnectionStrings__ProfileDb=Server=postgres;Port=5432;Database=profile_service_db;User Id=postgres;Password=postgres;
ConnectionStrings__WalletDb=Server=postgres;Port=5432;Database=wallet_service_db;User Id=postgres;Password=postgres;
ConnectionStrings__CatalogDb=Server=postgres;Port=5432;Database=catalog_service_db;User Id=postgres;Password=postgres;
ConnectionStrings__InventoryDb=Server=postgres;Port=5432;Database=inventory_service_db;User Id=postgres;Password=postgres;
ConnectionStrings__RabbitMQ=amqp://guest:guest@rabbitmq:5672/
ConnectionStrings__Redis=redis:6379

# ===== PostgreSQL container =====
POSTGRES_DB=auth_service_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
