# ===== GitHub Packages (private NuGet feed: Owlip.*) =====
# PAT needs the "read:packages" scope.
NUGET_USERNAME=your-github-username
NUGET_PASSWORD=ghp_your_personal_access_token

# ===== ASP.NET Core =====
ASPNETCORE_ENVIRONMENT=Docker
ASPNETCORE_URLS=http://+:8080

# ===== TemplateService database (host = compose service name) =====
ConnectionStrings__TemplateDb=Server=postgres;Port=5432;Database=template_service_db;User Id=postgres;Password=postgres;

# ===== PostgreSQL container =====
POSTGRES_DB=template_service_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===== JWT issuer (AuthService) =====
# template-service ходит за OIDC-метаданными на host.docker.internal —
# там должен быть доступен AuthService (например, GameServer на порту 5277).
AUTH_AUTHORITY=http://host.docker.internal:5277/
