# ===== GitHub Packages (private NuGet feed: Owlip.*) =====
# PAT needs the "read:packages" scope.
NUGET_USERNAME=your-github-username
NUGET_PASSWORD=ghp_your_personal_access_token

# ===== ASP.NET Core =====
ASPNETCORE_ENVIRONMENT=Docker
ASPNETCORE_URLS=http://+:8080

# ===== Databases (host = compose service name) =====
# Один сервер postgres, отдельная БД на сервис (каждый со своей схемой).
ConnectionStrings__TemplateDb=Server=postgres;Port=5432;Database=template_service_db;User Id=postgres;Password=postgres;
ConnectionStrings__AuthDb=Server=postgres;Port=5432;Database=auth_service_db;User Id=postgres;Password=postgres;

# ===== PostgreSQL container =====
POSTGRES_DB=template_service_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===== OIDC issuer (AuthService) =====
# template-service ходит за OIDC-метаданными внутри docker-сети.
AUTH_AUTHORITY=http://auth-service:8080/
